<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Sky Take Out - light-write" enabled="true"><elementProp name="TestPlan.user_defined_variables" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="BASE_URL" elementType="Argument"><stringProp name="Argument.name">BASE_URL</stringProp><stringProp name="Argument.value">${__P(BASE_URL,)}</stringProp></elementProp><elementProp name="USERS" elementType="Argument"><stringProp name="Argument.name">USERS</stringProp><stringProp name="Argument.value">${__P(USERS,1)}</stringProp></elementProp><elementProp name="RAMP_UP_SECONDS" elementType="Argument"><stringProp name="Argument.name">RAMP_UP_SECONDS</stringProp><stringProp name="Argument.value">${__P(RAMP_UP_SECONDS,1)}</stringProp></elementProp><elementProp name="DURATION_SECONDS" elementType="Argument"><stringProp name="Argument.name">DURATION_SECONDS</stringProp><stringProp name="Argument.value">${__P(DURATION_SECONDS,10)}</stringProp></elementProp><elementProp name="CACHE_STATE" elementType="Argument"><stringProp name="Argument.name">CACHE_STATE</stringProp><stringProp name="Argument.value">${__P(CACHE_STATE,warm)}</stringProp></elementProp><elementProp name="RUN_ID" elementType="Argument"><stringProp name="Argument.name">RUN_ID</stringProp><stringProp name="Argument.value">${__P(RUN_ID,)}</stringProp></elementProp></collectionProp></elementProp></TestPlan><hashTree>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="light-write workload" enabled="true"><stringProp name="ThreadGroup.num_threads">${USERS}</stringProp><stringProp name="ThreadGroup.ramp_time">${RAMP_UP_SECONDS}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${DURATION_SECONDS}</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController"><boolProp name="LoopController.continue_forever">true</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp></ThreadGroup><hashTree>
<CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="one isolated identity per worker" enabled="true"><stringProp name="filename">${__P(CREDENTIAL_DIR,)}/worker-${__threadNum}.csv</stringProp><stringProp name="fileEncoding">UTF-8</stringProp><stringProp name="variableNames">USER_ID,SESSION_ID,ORDER_NAMESPACE,CATEGORY_ID,PRODUCT_ID</stringProp><stringProp name="delimiter">,</stringProp><boolProp name="quotedData">true</boolProp><boolProp name="recycle">true</boolProp><boolProp name="stopThread">true</boolProp><stringProp name="shareMode">shareMode.thread</stringProp></CSVDataSet><hashTree/>
<HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="isolated auth and correlation" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">authentication</stringProp><stringProp name="Header.value">${AUTH_TOKEN}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">X-Performance-Run-Id</stringProp><stringProp name="Header.value">${RUN_ID}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="HTTP and Result contract" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def n=prev.responseCode?.isInteger()?prev.responseCode.toInteger():0; if(n&lt;200||n&gt;299){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('http_status_not_2xx');return}; def x; try{x=new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)}catch(e){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('invalid_result_json');return}; if(x.code!=1){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('business_result_not_success');return}; if(['auth-check','cart-list'].contains(prev.sampleLabel)&amp;&amp;x.data==null){AssertionResult.setFailure(true);AssertionResult.setFailureMessage('required_result_data_missing')}</stringProp></JSR223Assertion><hashTree/>
<OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="validate generated identity" enabled="true"/><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="auth-check" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/user/shoppingCart/list</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="create in-memory worker JWT" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def s=System.getenv('SKY_PERF_USER_JWT_SECRET');if(!s)throw new IllegalStateException('missing worker signing key');def enc={byte[] b-&gt;Base64.encoder.withoutPadding().encodeToString(b).replace('+','-').replace('/','_')};def h=enc('{&quot;alg&quot;:&quot;HS256&quot;,&quot;typ&quot;:&quot;JWT&quot;}'.getBytes('UTF-8'));def p=enc(groovy.json.JsonOutput.toJson([userId:vars.get('USER_ID') as Long,sessionId:vars.get('SESSION_ID'),exp:(System.currentTimeMillis()/1000L+(${__P(SESSION_TTL_SECONDS)} as Long))]).getBytes('UTF-8'));def u=h+'.'+p;def m=javax.crypto.Mac.getInstance('HmacSHA256');m.init(new javax.crypto.spec.SecretKeySpec(s.getBytes('UTF-8'),'HmacSHA256'));vars.put('AUTH_TOKEN',u+'.'+enc(m.doFinal(u.getBytes('UTF-8'))))</stringProp></JSR223PreProcessor><hashTree/></hashTree></hashTree>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="cart-add" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/user/shoppingCart/add</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;productId&quot;:${PRODUCT_ID}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="cart-list" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/user/shoppingCart/list</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/>
<HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="cart-sub" enabled="true"><stringProp name="HTTPSampler.path">${BASE_URL}/user/shoppingCart/sub</stringProp><stringProp name="HTTPSampler.method">POST</stringProp><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;productId&quot;:${PRODUCT_ID}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp></HTTPSamplerProxy><hashTree/>
</hashTree><ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="common JTL schema" enabled="true"><objProp><name>saveConfig</name><value class="SampleSaveConfiguration"><time>true</time><latency>true</latency><timestamp>true</timestamp><success>true</success><label>true</label><code>true</code><message>true</message><threadName>true</threadName><dataType>true</dataType><assertions>true</assertions><responseData>false</responseData><samplerData>false</samplerData><requestHeaders>false</requestHeaders><responseHeaders>false</responseHeaders><xml>false</xml><fieldNames>true</fieldNames><saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage><bytes>true</bytes><sentBytes>true</sentBytes><url>true</url><threadCounts>true</threadCounts><idleTime>true</idleTime><connectTime>true</connectTime></value></objProp><boolProp name="saveConfig.response_code">true</boolProp></ResultCollector><hashTree/>
