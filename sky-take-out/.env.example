MYSQL_DATABASE=sky_take_out
MYSQL_USERNAME=sky
MYSQL_PASSWORD=sky_dev_password
MYSQL_ROOT_PASSWORD=sky_root_dev_password
REDIS_PASSWORD=redis_dev_password
RABBITMQ_USERNAME=sky
RABBITMQ_PASSWORD=rabbit_dev_password
SKY_JWT_ADMIN_SECRET_KEY=replace-with-at-least-32-character-admin-key
SKY_JWT_USER_SECRET_KEY=replace-with-at-least-32-character-user-key
GRAFANA_ADMIN_PASSWORD=grafana_dev_password
# Interactive builds may use local; compose-smoke.ps1 always overrides this with git HEAD.
VCS_REF=local
MANAGEMENT_SERVER_ADDRESS=0.0.0.0
MANAGEMENT_SERVER_PORT=8081

# Optional integrations (blank/disabled values are safe for local Compose)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_FILE=
WECHAT_API_V3_KEY=
WECHAT_PAY_CERT_FILE=
WECHAT_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
BAIDU_MAP_AK=
SHOP_ADDRESS=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_TIMEOUT=60
SILICONFLOW_ENABLED=false

# Optional operational tuning
SKY_WEBSOCKET_TICKET_TTL=PT30S
SKY_WEBSOCKET_TICKET_KEY_PREFIX=websocket:ticket:
SKY_OUTBOX_ENABLED=true
SKY_OUTBOX_WORKER_ID=sky-compose-worker
SKY_OUTBOX_LEASE_DURATION=PT30S
SKY_OUTBOX_INITIAL_BACKOFF=PT2S
SKY_OUTBOX_MAX_BACKOFF=PT5M
SKY_OUTBOX_CONFIRM_TIMEOUT=PT5S
SKY_OUTBOX_MAX_ATTEMPTS=8
SKY_OUTBOX_POLL_DELAY_MS=1000
SKY_OUTBOX_HEALTH_PENDING_THRESHOLD=1000
SKY_OUTBOX_HEALTH_FAILED_THRESHOLD=0
SKY_OUTBOX_HEALTH_REFRESH_MS=30000
SKY_MESSAGING_CONSUMER_MAX_ATTEMPTS=3
